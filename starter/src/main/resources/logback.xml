<!-- Keeps worker output readable: workflow/activity println's and important SDK
     messages show through, but the SDK's chatty gRPC/Netty DEBUG logs are hidden. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{0} -- %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDOUT" />
    </root>

    <!-- Let Temporal's own INFO messages (worker startup, etc.) through. -->
    <logger name="io.temporal" level="INFO" />
</configuration>
